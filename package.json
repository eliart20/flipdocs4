{
  "name": "flipdocs4",
  "version": "0.1.0",
  "description": "Embeddable page-turning reader for PDF documents and ordered page images, with a typed React component and a framework-neutral entry point.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/flipdocs.js",
  "module": "./dist/flipdocs.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/flipdocs.js",
      "default": "./dist/flipdocs.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js",
      "default": "./dist/element.js"
    },
    "./style.css": "./dist/flipdocs.css",
    "./pdf.worker.min.mjs": "./dist/pdf.worker.min.mjs",
    "./raster-worker": "./dist/raster.worker.js",
    "./search-worker": "./dist/search.worker.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "sideEffects": [
    "**/*.css",
    "./dist/element.js"
  ],
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "vite build && vite build --config vite.workers.config.ts && node build/postbuild.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "audit:dist": "node build/audit-dist.mjs",
    "check": "npm run typecheck && npm run test && npm run build && npm run audit:dist && npm run verify:dist",
    "verify:dist": "node build/verify-dist.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "pdfjs-dist": "5.6.205",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "3.2.7"
  }
}
